# ============================================
# WEBSITE (Netlify) — Environment Variables
# ============================================
# Set ALL of these in Netlify → Site configuration → Environment variables
# Then trigger a new deploy for changes to take effect.

# Your deployed backend API URL on Render (NO trailing slash)
# Example: https://cosmic-tiers-backend.onrender.com
VITE_API_URL=https://your-backend.onrender.com

# Your Discord server invite link (used for the Discord buttons)
# This is a backup — the backend also provides this via /api/info
VITE_DISCORD_LINK=https://discord.gg/your-invite-code

# Your website's public Netlify URL (used in Info tab)
VITE_WEBSITE_LINK=https://your-site.netlify.app
