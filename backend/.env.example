# ============================================
# BACKEND (Koyeb) — Environment Variables
# ============================================

# PostgreSQL connection string (Supabase, Neon, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret key for bot → backend authentication (must match INTERNAL_API_KEY in bot)
INTERNAL_API_KEY=your_secret_key_here

# Your deployed website URL (used for CORS)
WEBSITE_LINK=https://your-website.vercel.app

# Your Discord server invite link (shown on website)
DISCORD_SERVER_LINK=https://discord.gg/your-invite

# Port (Koyeb sets this automatically, keep default)
PORT=3000
