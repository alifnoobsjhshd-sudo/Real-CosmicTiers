# Discord bot credentials
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Your Discord server ID
SERVER_ID=your_guild_id_here

# Backend API URL (your Koyeb backend URL)
WEBSITE_API_URL=https://your-backend.koyeb.app

# Must match INTERNAL_API_KEY in backend
INTERNAL_API_KEY=your_secret_key_here

# Website URL shown in bot embeds
WEBSITE_LINK=https://your-website.vercel.app
